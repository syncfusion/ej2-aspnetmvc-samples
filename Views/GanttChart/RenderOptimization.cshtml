@using Syncfusion.EJ2
@using Newtonsoft.Json
@{
    ViewData["Title"] = "RenderOptimization";
    var dropdownData = new[]
    {
        new { Text = "5000 Rows", Value = "5000" },
        new { Text = "10000 Rows", Value = "10000" }
    };
}

@section ControlsSection{
    <div class="control-section">
        <div style="display:flex;">
            <div style="width:130px;padding-bottom:10px;">
                @(Html.EJS().DropDownList("recordCount")
                    .DataSource((IEnumerable<object>)dropdownData)
                    .Fields(new Syncfusion.EJ2.DropDowns.DropDownListFieldSettings { Text = "Text", Value = "Value" })
                    .Index(0)
                    .Change("onDropdownChange")
                    .Render()
                )
            </div>
            <span style="padding-left:20px;font-size:15px;margin-top:5px;">
                <b>Data initial load time:</b>
                <span id="loadTime">0</span> sec
            </span>
        </div>
        @(Html.EJS().Gantt("RenderOptimization").DataSource((IEnumerable<object>)ViewData["DataSource"]).TreeColumnIndex(1)
            .EnableVirtualization(true).AllowSelection(true).EnablePredecessorValidation(false).AutoCalculateDateScheduling(false)
            .HighlightWeekends(true).Height("650px").Width("100%").RowHeight(46).TaskbarHeight(25)
            .DataBound("onDataBound")
            .TaskFields(ts => ts.Id("TaskId").Name("TaskName").StartDate("StartDate").EndDate("EndDate")
            .Duration("Duration").Progress("Progress").ParentID("ParentID").Dependency("Predecessor"))
            .LabelSettings(ls => ls.TaskLabel("Progress"))
            .SplitterSettings(sp => sp.ColumnIndex(2))
            .Columns(col =>
            {
                col.Field("TaskId").Width(80).Add();
                col.Field("TaskName").HeaderText("Task Name").Width(300).Add();
                col.Field("StartDate").Format("MM/dd/yyyy").Add();
                col.Field("Duration").Add();
                col.Field("Progress").Format("n").Add();
            })
            .ProjectStartDate("03/29/2026")
            .ProjectEndDate("09/20/2026")
            .Render()
        )
    </div>

    <script>
        let startLoadTime = new Date();
        let shouldCalculateLoadTime = true;

        const data5000 = @Html.Raw(
            JsonConvert.SerializeObject(
                EJ2MVCSampleBrowser.Models.GanttData.GenerateVirtualData(5000)
            )
        );

        const data10000 = @Html.Raw(
            JsonConvert.SerializeObject(
                EJ2MVCSampleBrowser.Models.GanttData.GenerateVirtualData(10000)
            )
        );

        function onDropdownChange(args) {
            var gantt = document.getElementById('RenderOptimization').ej2_instances[0];
            startLoadTime = new Date();
            shouldCalculateLoadTime = true;
            if (args.value == "122") {
                gantt.dataSource = data5000;
            }
            else {
                gantt.dataSource = data10000;
            }
            gantt.refresh();
        }

        function onDataBound() {
            if (!shouldCalculateLoadTime) {
                return;
            }
            shouldCalculateLoadTime = false;
            var diff = (new Date().getTime() - startLoadTime.getTime()) / 1000;
            document.getElementById("loadTime").innerHTML = diff.toFixed(2);
        }
    </script>
}

@section ActionDescription{
    <div id="action-description">
        <p>
            This sample demonstrates render optimization in Gantt by minimizing DOM updates during rendering.
            The sample disables <code>autoCalculateDateScheduling</code> and uses a valid pre-calculated data source
            so task dates are not recomputed during rendering, improving initial load performance.
        </p>
    </div>
}

@section Description{
    <div id="description">
        <p>
            This demo measures initial data load time and demonstrates render optimization by disabling <code>autoCalculateDateScheduling</code> and
            providing a valid (pre-calculated) data source so the Gantt does not recompute task dates during rendering. When combined with
            virtualization, this reduces DOM updates and improves both initial load and scroll performance.
        </p>
        <p>More information on the Essential<sup>Â®</sup> Gantt Chart can be found in this <a target="_blank" href="https://help.syncfusion.com/gantt-sdk/asp-net-mvc/gantt-chart/getting-started">documentation section.</a></p>
        <br/>
        <p>Looking for the full ASP.NET MVC Gantt Chart component overview, features, pricing, and documentation? Visit the <a target="_blank" href="https://www.syncfusion.com/gantt-sdk/aspnet-mvc-gantt-chart">ASP.NET MVC Gantt Chart</a> page.</p>
    </div>
}

@section Meta{
    <meta name="description"
          content="This example demonstrates render optimization and virtualization in ASP.NET MVC Gantt control." />
}

@section Title{
    <title>ASP.NET MVC Gantt Render Optimization Example - Syncfusion Demos </title>
}

@section Header{
    <h1 class='sb-sample-text'>Example of Render Optimization in ASP.NET MVC Gantt Control</h1>
}