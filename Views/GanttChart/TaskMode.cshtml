@using Syncfusion.EJ2
@{
    ViewData["Title"] = "ResourceAllocation";
}

@section ControlsSection{
    <div class="control-section">
        <div class="content-wrapper">
            @(Html.EJS().Gantt("ResourceAllocation").DataSource((IEnumerable<object>)ViewData["DataSource"])
                .Height("450px").HighlightWeekends(true).AllowSelection(true)
                .TaskFields(ts => ts.Id("TaskId").Name("TaskName").Work("Work").StartDate("StartDate").EndDate("EndDate")
                .Duration("Duration").Progress("Progress").Dependency("Predecessor").Manual("IsManual").ResourceInfo("ResourceId")
                .Child("SubTasks")).ResourceNameMapping("ResourceName").ResourceIDMapping("ResourceId")
                .TreeColumnIndex(1).TaskMode(Syncfusion.EJ2.Gantt.ScheduleMode.Custom).TaskType(Syncfusion.EJ2.Gantt.TaskType.FixedWork)
                .EditSettings(es => es.AllowAdding(true).AllowEditing(true).AllowDeleting(true).AllowTaskbarEditing(true).ShowDeleteConfirmDialog(true))
                .Toolbar(new List<string>
                    () { "Add", "Edit", "Update", "Delete", "Cancel", "ExpandAll", "CollapseAll" })
                .Resources((IEnumerable<object>)ViewData["Resources"])
                .Columns(col =>
                {
                    col.Field("TaskId").Visible(false).Add();
                    col.Field("TaskName").HeaderText("Task Name").Add();
                    col.Field("IsManual").Add();
                })
                .LabelSettings(ls => ls.LeftLabel("TaskName"))
                .SplitterSettings(sp => sp.Position("35%"))
                .ProjectStartDate("02/20/2024")
                .ProjectEndDate("03/30/2024")
                .Render()
            )
        </div>
    </div>
}

@section ActionDescription {
    <div id="action-description">
        <p>The Gantt provides support for automatic and manual task scheduling modes. Scheduling mode of a task is used to indicate whether the start and end dates of a task will be automatically validated or not. Using the property <a target="_blank" href="https://help.syncfusion.com/cr/aspnetmvc-js2/syncfusion.ej2.gantt.gantt.html#Syncfusion_EJ2_Gantt_Gantt_TaskMode">taskMode</a> property controls whether tasks are scheduled automatically, manually, or through a custom mode that maps the scheduling behavior from the data source.</p>
    </div>
}

@section Meta{
    <meta name="description" content="This example demonstrates the Task Scheduling Mode in ASP.NET MVC Gantt control. Explore here for more details."/>
}

@section Description {
    <div id="description">
        <p>The Gantt Chart supports three scheduling modes through the <code>taskMode</code> property: <code>Auto</code>, <code>Manual</code> and <code>Custom</code></p>
        <ul>
          <li><code>Auto</code> - All tasks are automatically scheduled, and task dates are validated based on scheduling rules and dependencies.</li>
          <li><code>Manual</code> - All tasks are manually scheduled, and task dates are maintained without automatic validation.</li>
          <li><code>Custom</code> - The scheduling mode is determined for each task individually using a mapped data source field.</li>
        </ul>
        <p>In this sample, <code><a target="_blank" href="https://help.syncfusion.com/cr/aspnetmvc-js2/syncfusion.ej2.gantt.gantt.html#Syncfusion_EJ2_Gantt_Gantt_TaskMode">taskMode</a></code> property is set <code>Custom</code>, and the scheduling behavior of each task is mapped using the <code>Manual</code> task field. This allows both automatically scheduled and manually scheduled tasks to coexist within the same project.</p>
        <p>More information on the Essential<sup>®</sup> Gantt Chart can be found in this <a target="_blank" href="https://ej2.syncfusion.com/aspnetmvc/documentation/gantt/task-scheduling">scheduling tasks</a> documentation section.</p>
        <br/>
        <p>Looking for the full ASP.NET MVC Gantt Chart component overview, features, pricing, and documentation? Visit the <a target="_blank" href="https://www.syncfusion.com/gantt-sdk/aspnet-mvc-gantt-chart">ASP.NET MVC Gantt Chart</a> page.</p>
    </div>
}

@section Title{
    <title>ASP.NET MVC Gantt Task Scheduling Mode Example - Syncfusion Demos </title> 
}
@section Header{
    <h1 class='sb-sample-text'>Example of Task Scheduling Mode in ASP.NET MVC Gantt Control</h1>
}