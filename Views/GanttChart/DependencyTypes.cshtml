@using Syncfusion.EJ2
@using Syncfusion.EJ2.Gantt
@{
    ViewData["Title"] = "DependencyTypes";
    var dependencyTypes = new[]
    {
        new { Text = "Finish to Start (FS)", Value = "FS" },
        new { Text = "Start to Start (SS)", Value = "SS" },
        new { Text = "Finish to Finish (FF)", Value = "FF" },
        new { Text = "Start to Finish (SF)", Value = "SF" }
    };

    // MultiSelect still reads these as strings:
    var defaultValues = new[] { "FS", "SS", "FF", "SF" };

    Func<List<DependencyType>, string[]> ConvertToStrings = (list) => 
        list.Select(x => x.ToString()).ToArray();

    var allowedDependencyTypes = new List<DependencyType>
    {
        DependencyType.FS,
        DependencyType.SS,
        DependencyType.FF,
        DependencyType.SF
    };
}

@section ControlsSection {
    <div class="control-section">
        <div style="margin-bottom:12px;">
            <div style="display:flex;align-items:center;gap:12px;">
                <label style="font-weight:600;margin:0;">
                    Allowed Dependency Types:
                </label>
                @(Html.EJS().MultiSelect("dependencyTypes")
                    .DataSource((IEnumerable<object>)dependencyTypes)
                    .Value((string[])defaultValues)
                    .Fields(new Syncfusion.EJ2.DropDowns.MultiSelectFieldSettings { Text = "Text", Value = "Value" })
                    .Mode(Syncfusion.EJ2.DropDowns.VisualMode.CheckBox)
                    .ShowDropDownIcon(true).ShowClearButton(false).PopupHeight("220px").Width("250px")
                    .Change("dependencyTypeChange")
                    .Render()
                )
            </div>
        </div>

        @(Html.EJS().Gantt("DependencyTypes").DataSource((IEnumerable<object>)ViewData["DataSource"])
            .Height("650px").RowHeight(46).TaskbarHeight(25)
            .AllowSelection(true).HighlightWeekends(true).TreeColumnIndex(1)
            .GridLines(Syncfusion.EJ2.Gantt.GridLine.Both)
            .ProjectStartDate("01/01/2026")
            .AllowedDependencyTypes(ConvertToStrings(allowedDependencyTypes))
            .Toolbar((IEnumerable<string>)ViewData["ToolbarItems"])
            .TaskFields(ts => ts.Id("TaskId").Name("TaskName").StartDate("StartDate").EndDate("EndDate")
                .Duration("Duration").Progress("Progress").Dependency("Predecessor").ParentID("ParentID"))
            .EditSettings(es => es.AllowAdding(true).AllowEditing(true).AllowDeleting(true)
                .AllowTaskbarEditing(true).ShowDeleteConfirmDialog(true))
            .LabelSettings(ls => ls.LeftLabel("TaskName"))
            .SplitterSettings(sp => sp.ColumnIndex(3))
            .Columns(col =>
            {
                col.Field("TaskId").Visible(false).Add();
                col.Field("TaskName").HeaderText("Task Name").Width(200).Add();
                col.Field("Predecessor").HeaderText("Dependency").Width(140).Add();
                col.Field("StartDate").HeaderText("Start Date").Width(130).Format("MM/dd/yyyy").Add();
                col.Field("Duration").HeaderText("Duration").Width(110).Add();
                col.Field("Progress").HeaderText("Progress").Width(100).Format("n").Add();
            })
            .Render()
        )
    </div>
    <script>
        function dependencyTypeChange(args) {
            var ganttObj = document.getElementById('DependencyTypes').ej2_instances[0];
            // Update allowedDependencyTypes with the selected values from MultiSelect
            ganttObj.allowedDependencyTypes = args.value && args.value.length > 0 ? args.value : ['FS', 'SS', 'FF', 'SF'];
            ganttObj.refresh();
        }
    </script>
}

@section ActionDescription {
    <div id="action-description">
        <p>
            The Gantt Chart supports dependency types to define
            relationships between tasks, helping control execution
            order and project sequencing.
        </p>
    </div>
}

@section Description {
    <div id="description">
        <p>
            The Gantt Chart supports various dependency relationship
            types to manage task links. The
            <code>allowedDependencyTypes</code> property is used
            to restrict the dependency types available during task
            editing and dependency creation.
        </p>
        <p>
            The different dependency types are:
        </p>
        <ul>
            <li><code>FS</code> - Finish to Start</li>
            <li><code>SS</code> - Start to Start</li>
            <li><code>FF</code> - Finish to Finish</li>
            <li><code>SF</code> - Start to Finish</li>
        </ul>
        <p>
            When dependency types are configured, the Gantt validates
            newly created and modified links against the selected
            relationship types.
        </p>
        <p>More information on the Essential<sup>®</sup> Gantt Chart can be found in this <a target="_blank" href="https://help.syncfusion.com/gantt-sdk/asp-net-mvc/gantt-chart/task-dependency">task dependency</a> documentation section.</p>
        <br/>
        <p>Looking for the full ASP.NET MVC Gantt Chart component overview, features, pricing, and documentation? Visit the <a target="_blank" href="https://www.syncfusion.com/gantt-sdk/aspnet-mvc-gantt-chart">ASP.NET MVC Gantt Chart</a> page.</p>
    </div>
}

@section Meta {
    <meta name="description" content="This example demonstrates dependency lead and lag offsets in ASP.NET MVC Gantt Chart." />
}

@section Title {
    <title>ASP.NET Core Gantt Dependency Offset Example - Syncfusion Demos</title>
}

@section Header {
    <h1 class="sb-sample-text">
        Example of Dependency Offset in ASP.NET Core Gantt Control
    </h1>
}