@using Syncfusion.EJ2
@using Syncfusion.EJ2.Kanban
@{
    string[] orderTransition = { "Ready to Serve", "Ready to Deliver" };
    string[] serveTransition = { "Served" };
    string[] deliverTransition = { "Delivered" };
}
@section ControlsSection {
    <div class="col-lg-12 control-section">
        <div class="control_wrapper">
       @Html.EJS().Kanban("kanban").KeyField("Category").DataSource((IEnumerable<object>)ViewData["data"]).Columns(col =>
       {
           col.HeaderText("Order").KeyField("Order").AllowDrop(false).AllowToggle(true).TransitionColumns(orderTransition).Add();
           col.HeaderText("Ready to Serve").KeyField("Ready to Serve").AllowToggle(true).TransitionColumns(serveTransition).Add();
           col.HeaderText("Home Delivery").KeyField("Ready to Deliver").AllowToggle(true).TransitionColumns(deliverTransition).Add();
           col.HeaderText("Delivered").KeyField("Delivered, Served").AllowToggle(true).AllowDrag(false).Add();
       }).CardSettings(card =>
       {
           card.HeaderField("Id").ContentField("Description").Template("#cardTemplate");
       }).Render()
        </div>
    </div>
    <script id="cardTemplate" type="text/x-jsrender">
        <div class='card-template'>
            <div class='card-template-wrap'>
                <div>
                    <div class='e-card-header'>
                        <div class='e-card-header-caption'>
                            <div class='e-card-header-title e-tooltip-text'>${Title}</div>
                        </div>
                    </div>
                    <div class='e-card-content'>
                        <div class='e-text'>${Description}</div>
                        <div class='e-card-kanban-image'><img src='../Content/images/Kanban/${ImageURL}' alt=''></div>
                    </div>
                    <div class='e-card-custom-footer'>
                        ${getTags(data.Tags)}
                    </div>
                </div>
            </div>
        </div>
    </script>
    <script>
        function getTags(data) {
            var tagDiv = '';
            var tags = data.split(',');
            for (var a = 0; a < tags.length; a++) {
                var tag = tags[a];
                tagDiv += '<div class="e-card-tag-field">' + tag + '</div>';
            }
            return tagDiv;
        }
    </script>
    <style>
        .e-kanban .e-card-kanban-image {
            height: 45px;
            width: 45px;
            margin-left: auto;
        }

            .e-kanban .e-card-kanban-image img {
                height: inherit;
                width: inherit;
                border-radius: 50%;
            }

        .e-kanban .e-card .e-card-tag-field {
            background: #ececec;
            color: #6b6b6b;
            margin-right: 5px;
            line-height: 1.1;
            font-size: 13px;
            border-radius: 3px;
            padding: 4px;
        }

        .e-kanban .e-card-custom-footer {
            display: flex;
            padding: 0px 12px 12px;
            line-height: 1;
            height: 35px;
        }

        .e-kanban .e-card td {
            background-color: #fff;
        }

        .e-kanban .e-card .e-card-content {
            display: flex;
        }

        .e-kanban .e-card .e-text {
            width: fit-content;
        }
    </style>
}
@section ActionDescription{
    <div id="action-description">
    <p>
        This sample demonstrates workflow customization in the Kanban component, enabling controlled card transitions between workflow stages based on predefined business rules.
    </p>
    </div>
}
@section Description{
    <div id="description">
    <p>
        This sample demonstrates workflow validation in the Kanban component by restricting card movement between specific columns. Workflow rules help ensure that cards progress through predefined stages and follow the intended business process.
    </p>
    <p>
        The following column properties are used to control card transitions:
    </p>
    <ul>
        <li>
            <a href="https://help.syncfusion.com/cr/aspnetmvc-js2/Syncfusion.EJ2.Kanban.KanbanColumn.html#Syncfusion_EJ2_Kanban_KanbanColumn_TransitionColumns" target="_blank">transitionColumns</a>:
            Specifies the columns to which cards can be moved from the current column.
        </li>
        <li>
            <a href="https://help.syncfusion.com/cr/aspnetmvc-js2/Syncfusion.EJ2.Kanban.KanbanColumn.html#Syncfusion_EJ2_Kanban_KanbanColumn_AllowDrag" target="_blank">allowDrag</a>:
            Enables or disables dragging cards from a column.
        </li>
        <li>
            <a href="https://help.syncfusion.com/cr/aspnetmvc-js2/Syncfusion.EJ2.Kanban.KanbanColumn.html#Syncfusion_EJ2_Kanban_KanbanColumn_AllowDrop" target="_blank">allowDrop</a>:
            Enables or disables dropping cards into a column.
        </li>
    </ul>

    <p>
        More information on the Essential<sup>®</sup> JS2 Kanban board can be found in this
        <a href="https://help.syncfusion.com/cr/aspnetmvc-js2/Syncfusion.EJ2.Kanban.KanbanColumn.html#Syncfusion_EJ2_Kanban_KanbanColumn_TransitionColumns" target="_blank">transition columns</a> documentation section.
    </p>
    <p>
        Looking for the full ASP.NET Core Kanban component overview, features, pricing, and documentation?
        Visit the <a href="https://www.syncfusion.com/gantt-sdk/aspnet-mvc-kanban-board" target="_blank">ASP.NET MVC</a> page.
    </p>
    </div>
}

@section Meta{
                    <meta name="description" content="This example demonstrates the Workflow in ASP.NET MVC Kanban control. Explore here for more details."/>
                }

@section Title{
                    <title>ASP.NET MVC Kanban Workflow Example - Syncfusion Demos </title> 
                }
@section Header{
                    <h1 class='sb-sample-text'>Example of Workflow in ASP.NET MVC Kanban Control</h1>
                }