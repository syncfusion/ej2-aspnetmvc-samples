@using Syncfusion.EJ2
@using Syncfusion.EJ2.Kanban

@section ControlsSection {
    <div class="control-section">
        <div class="control_wrapper">
            @Html.EJS().Kanban("kanban").KeyField("Status").AllowDragAndDrop(false).DataSource(dataManger =>
       { dataManger.Url("https://services.syncfusion.com/aspnet/production/api/Kanban").CrossDomain(true);
       }).Columns(col=> {
           col.HeaderText("To Do").KeyField("Open").Add();
           col.HeaderText("In Progress").KeyField("InProgress").Add();
           col.HeaderText("Testing").KeyField("Testing").Add();
           col.HeaderText("Done").KeyField("Close").Add();
       }).CardSettings(card =>  {
            card.ContentField("Summary").HeaderField("Id");
            }).DialogOpen("onDialogOpen").Render()
        </div>
    </div>
    <style>
    </style>
}
@section ActionDescription{
    <div id="action-description">
        <p>
            This demo presents a task management workflow rendered on a Kanban board using a remote
            service as the data source. It demonstrates the essential
            <a href="https://ej2.syncfusion.com/aspnetmvc/documentation/kanban/data-binding" target="_blank">dataSource</a>
            property that binds a <a href="https://ej2.syncfusion.com/aspnetmvc/documentation/data/overview" target="_blank">DataManager</a>
            instance to the board, along with the
            <a href="https://ej2.syncfusion.com/aspnetmvc/documentation/kanban/columns" target="_blank">columns</a>,
            <a href="https://ej2.syncfusion.com/aspnetmvc/documentation/kanban/key-field" target="_blank">keyField</a>,
            and the <a href="https://ej2.syncfusion.com/aspnetmvc/documentation/kanban/events#dialogopen" target="_blank">dialogOpen</a>
            event APIs. The <code>DataManager</code> fetches the task collection from a remote endpoint and
            the <code>dialogOpen</code> event is used to cancel the default dialog so the cards remain
            read-only on double-click.
        </p>
    </div>
}
@section Description{
    <div id="description">
    <p>
        This sample demonstrates remote data binding in the Kanban component using the
        <a href="https://ej2.syncfusion.com/aspnetmvc/documentation/kanban/data-binding" target="_blank">dataSource</a>
        property and a
        <a href="https://ej2.syncfusion.com/aspnetmvc/documentation/data/overview" target="_blank">DataManager</a>
        instance. The DataManager acts as an intermediary between the Kanban board and a remote service, enabling data to be fetched and displayed from external data sources.
    </p>
    <p>
        To connect with a remote service, the DataManager requires a service endpoint URL and an adaptor. The adaptor is responsible for processing requests and responses between the component and the remote data source. The <code>syncfusion/ej2-data</code> package provides several built-in adaptors, including <code>UrlAdaptor</code>, <code>ODataAdaptor</code>, <code>ODataV4Adaptor</code>, <code>WebApiAdaptor</code>, and <code>WebMethodAdaptor</code>, for working with different service types.
    </p>
    <p>
        More information on the Essential<sup>®</sup> JS2 Kanban board can be found in this
        <a href="https://ej2.syncfusion.com/aspnetmvc/documentation/kanban/data-binding#remote-data" target="_blank">remote data</a> documentation section.
    </p>
    <p>
        Looking for the full ASP.NET Core Kanban component overview, features, pricing, and documentation?
        Visit the <a href="https://www.syncfusion.com/gantt-sdk/aspnet-mvc-kanban-board" target="_blank">ASP.NET MVC</a> page.
    </p>
    </div>
}
<script>
    function onDialogOpen(args) {
        args.cancel = true;
    }
</script>

@section Meta{
                    <meta name="description" content="This example demonstrates the Remote Data in ASP.NET MVC Kanban control. Explore here for more details."/>
                }

@section Title{
                    <title>ASP.NET MVC Kanban Remote Data Example - Syncfusion Demos </title> 
                }
@section Header{
                    <h1 class='sb-sample-text'>Example of Remote Data in ASP.NET MVC Kanban Control</h1>
                }
