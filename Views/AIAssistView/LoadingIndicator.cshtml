@using Syncfusion.EJ2.InteractiveChat
@using Syncfusion.EJ2.DropDowns
@using Syncfusion.EJ2
@using Newtonsoft.Json

@section ControlsSection{
    <div class="col-lg-8 control-section">
        <div class="loading-indicator-aiassistview">
            @Html.EJS().AIAssistView("aiAssistView").ToolbarSettings(new AIAssistViewToolbarSettings() { Items = ViewData["ToolbarItems"], ItemClicked = "toolbarItemClicked" }).PromptSuggestions((string[])ViewData["PromptSuggestionData"]).BannerTemplate("#bannerContent").PromptRequest("onPromptRequest").EnableStreaming(true).ResponseAnimationTemplate("#dotAnimationTemplate").Created("onCreated").Render()
        </div>
    </div>
    <div class="col-lg-4 property-section loading-indicator-property-section">
        <table id="property" title="Properties">
            <tbody>
                <tr>
                    <td>
                        <div>Loading Types</div>
                    </td>
                    <td style="padding-right: 10px">
                        <div>
                            @Html.EJS().DropDownList("loadingType").Width("220px").PopupHeight("200px").Index(0).DataSource(ViewData["LoadingTypeDataSource"]).Fields(new DropDownListFieldSettings { Text = "Text", Value = "Value" }).Change("onLoadingTypeChange").Render()
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>

    <style>
        .loading-indicator-aiassistview {
            height: 600px;
            width: 100%;
            max-width: 720px;
            margin: 0 auto;
            position: relative;
        }

        .loading-indicator-property-section {
            margin-top: 25px;
        }

            .loading-indicator-property-section .property-panel-content td {
                padding: 10px 0px;
            }

        @@media only screen and (max-width: 850px) {
            .loading-indicator-aiassistview {
                width: 100%;
            }
        }

        .loading-indicator-aiassistview .banner-content {
            display: flex;
            flex-direction: column;
            justify-content: center;
            text-align: center;
            align-items: center;
            height: 330px;
        }

            .loading-indicator-aiassistview .banner-content .e-assistview-icon:before {
                font-size: 35px;
            }

        .assistview-loading-status {
            display: flex;
            gap: 10px;
            color: #666;
            font-family: "Segoe UI", system-ui, sans-serif;
            font-size: 14px;
            font-weight: 500;
            line-height: 1.4;
        }

        .assistview-icon-text-loading {
            display: inline-flex;
            gap: 8px;
            color: #666;
            font-family: "Segoe UI", system-ui, sans-serif;
            font-size: 14px;
            font-weight: 500;
        }

            .assistview-icon-text-loading .e-icons {
                font-size: 16px;
                color: #0078d4;
                animation: assistview-spin 1.6s linear infinite;
            }

        @@keyframes assistview-spin {
            from {
                transform: rotate(0deg);
            }

            to {
                transform: rotate(360deg);
            }
        }

        .assistview-animation-loading {
            display: inline-flex;
            gap: 6px;
            padding: 6px 10px;
            border-radius: 16px;
            background: linear-gradient(90deg, #f3f3f3 0%, #e7e7e7 50%, #f3f3f3 100%);
            background-size: 200% 100%;
            animation: assistview-shimmer 1.5s ease-in-out infinite;
            font-family: "Segoe UI", system-ui, sans-serif;
            font-size: 13px;
            font-weight: 500;
            color: #555;
        }

        .assistview-animation-dots {
            display: inline-flex;
            gap: 3px;
            margin-left: 4px;
        }

            .assistview-animation-dots span {
                width: 5px;
                height: 5px;
                border-radius: 50%;
                background: #6c63ff;
                animation: assistview-bounce 1.2s ease-in-out infinite;
            }

                .assistview-animation-dots span:nth-child(1) {
                    animation-delay: 0s;
                }

                .assistview-animation-dots span:nth-child(2) {
                    animation-delay: 0.15s;
                }

                .assistview-animation-dots span:nth-child(3) {
                    animation-delay: 0.3s;
                }

        @@keyframes assistview-shimmer {
            0% {
                background-position: 200% 0;
            }

            100% {
                background-position: -200% 0;
            }
        }

        @@keyframes assistview-bounce {
            0%, 80%, 100% {
                transform: scale(0.6);
                opacity: 0.5;
            }

            40% {
                transform: scale(1);
                opacity: 1;
            }
        }

        .assistview-dot-loading {
            display: inline-flex;
            gap: 4px;
            padding: 4px 0;
        }

            .assistview-dot-loading span {
                width: 8px;
                height: 8px;
                border-radius: 50%;
                background: #0078d4;
                animation: assistview-dot-blink 1.4s infinite ease-in-out;
            }

                .assistview-dot-loading span:nth-child(1) {
                    animation-delay: 0s;
                }

                .assistview-dot-loading span:nth-child(2) {
                    animation-delay: 0.2s;
                }

                .assistview-dot-loading span:nth-child(3) {
                    animation-delay: 0.4s;
                }

        @@keyframes assistview-dot-blink {
            0%, 80%, 100% {
                opacity: 0.3;
                transform: scale(0.8);
            }

            40% {
                opacity: 1;
                transform: scale(1.2);
            }
        }

        .assistview-spinner-loading {
            display: inline-flex;
        }

            .assistview-spinner-loading .spinner {
                width: 25px;
                height: 25px;
                border: 3px solid #e5e5e5;
                border-top-color: #0078d4;
                border-radius: 50%;
                animation: assistview-spinner-rotate 0.8s linear infinite;
            }

        @@keyframes assistview-spinner-rotate {
            from {
                transform: rotate(0deg);
            }

            to {
                transform: rotate(360deg);
            }
        }

        .assistview-status-loading {
            position: relative;
            display: inline-block;
            min-width: 200px;
            height: 22px;
            font-size: 14px;
            font-weight: 500;
            color: #666;
            font-family: "Segoe UI", system-ui, sans-serif;
        }

            .assistview-status-loading > span {
                position: absolute;
                left: 0;
                top: 0;
                white-space: nowrap;
                opacity: 0;
            }

            .assistview-status-loading > .status-1 {
                animation: assistview-status-cycle-1 3s linear forwards;
            }

            .assistview-status-loading > .status-2 {
                animation: assistview-status-cycle-2 3s linear forwards;
            }

            .assistview-status-loading > .status-3 {
                animation: assistview-status-cycle-3 3s linear forwards;
            }

        @@keyframes assistview-status-cycle-1 {
            0% {
                opacity: 1;
            }

            33%, 100% {
                opacity: 0;
            }
        }

        @@keyframes assistview-status-cycle-2 {
            0%, 33% {
                opacity: 0;
            }

            34%, 66% {
                opacity: 1;
            }

            67%, 100% {
                opacity: 0;
            }
        }

        @@keyframes assistview-status-cycle-3 {
            0%, 66% {
                opacity: 0;
            }

            67%, 100% {
                opacity: 1;
            }
        }

        .assistview-text-indicator {
            display: inline;
            font-family: "Segoe UI", system-ui, sans-serif;
            font-size: 14px;
            font-weight: 500;
            color: #666;
            line-height: 1;
        }

            .assistview-text-indicator > span:first-child {
                animation: assistview-text-flash 1.2s infinite ease-in-out;
            }

        .assistview-dots {
            display: inline-flex;
            align-items: center;
            gap: 2px;
            line-height: 1;
            line-height: 1;
        }

            .assistview-dots span {
                width: 4px;
                height: 4px;
                border-radius: 50%;
                background: #666;
                animation: assistview-dot-wave 1.2s infinite;
                display: inline-block;
                margin-left: 2px;
                vertical-align: baseline;
            }

                .assistview-dots span:nth-child(2) {
                    animation-delay: .2s;
                }

                .assistview-dots span:nth-child(3) {
                    animation-delay: .4s;
                }

        @@keyframes assistview-dot-wave {
            0%, 80%, 100% {
                opacity: .3;
                transform: translateY(0);
            }

            40% {
                opacity: 1;
                transform: translateY(-3px);
            }
        }

        @@keyframes assistview-text-flash {
            0%, 100% {
                opacity: 0.6;
            }

            50% {
                opacity: 1;
            }
        }

        body[class*="dark"] .assistview-loading-status,
        body[class*="high"] .assistview-loading-status,
        body[class*="dark"] .assistview-icon-text-loading,
        body[class*="high"] .assistview-icon-text-loading,
        body[class*="dark"] .assistview-animation-loading,
        body[class*="high"] .assistview-animation-loading,
        body[class*="dark"] .assistview-status-loading,
        body[class*="high"] .assistview-status-loading,
        body[class*="dark"] .assistview-text-indicator,
        body[class*="high"] .assistview-text-indicator,
        body[class*="dark"] .assistview-text-indicator .assistview-dots span,
        body[class*="high"] .assistview-text-indicator .assistview-dots span {
            color: #d0d0d0;
        }

        body[class*="dark"] .assistview-dot-loading span,
        body[class*="high"] .assistview-dot-loading span {
            background: #6c9fd8;
        }

        body[class*="dark"] .assistview-spinner-loading .spinner,
        body[class*="high"] .assistview-spinner-loading .spinner {
            border-color: #444;
            border-top-color: #6c9fd8;
        }

        body[class*="dark"] .assistview-animation-loading,
        body[class*="high"] .assistview-animation-loading {
            background: linear-gradient(90deg, #3a3a3a 0%, #2a2a2a 50%, #3a3a3a 100%);
            background-size: 200% 100%;
        }
    </style>
    @*custom code end*@
}

@section PreScripts {
    <script>
        var prompts = @Html.Raw(Json.Encode(ViewData["PromptResponseData"]));
        var suggestions = @Html.Raw(Json.Encode(ViewData["PromptSuggestionData"]));
        var loadingAIAssistView;
        var loadingTypeSourceIds = {
            dot: 'dotAnimationTemplate',
            spinner: 'spinnerAnimationTemplate',
            text: 'textAnimationTemplate',
            textIndicator: 'textIndicatorAnimationTemplate'
        };
        var selectedLoadingType = 'dot';

        function applyLoadingTemplate() {
            if (!loadingAIAssistView) return;
            var sourceId = loadingTypeSourceIds[selectedLoadingType] || loadingTypeSourceIds.dot;
            var sourceScript = document.getElementById(sourceId);
            if (!sourceScript) return;
            var skeleton = loadingAIAssistView.skeletonContainer
                || document.querySelector('#aiAssistView .e-output-container.e-response-animation-template');
            if (skeleton) {

                skeleton.innerHTML = sourceScript.textContent;
            }
        }

        function onCreated() {
            var assistEle = document.getElementById('aiAssistView');
            loadingAIAssistView = ej.base.getInstance(assistEle, ejs.interactivechat.AIAssistView);
            applyLoadingTemplate();
        }

        function onLoadingTypeChange(args) {
            if (!args || !args.value) {
                return;
            }
            selectedLoadingType = args.value;
            applyLoadingTemplate();
        }

        function onPromptRequest(args) {
            var context = this;
            setTimeout(function () {
                var foundPrompt = prompts.find(function (p) { return p.Prompt === args.prompt; });
                var defaultResponse = 'For real-time prompt processing, connect the AI AssistView control to your preferred AI service, such as OpenAI or Azure Cognitive Services. Ensure you obtain the necessary API credentials to authenticate and enable seamless integration.';
                var responseHtml = foundPrompt
                    ? (foundPrompt.RegeneratedResponses && foundPrompt.RegeneratedResponses.length > 0
                        ? foundPrompt.RegeneratedResponses[Math.floor(Math.random() * foundPrompt.RegeneratedResponses.length)]
                        : foundPrompt.Response)
                    : defaultResponse;
                context.addPromptResponse(responseHtml);
                context.promptSuggestions = suggestions;
            }, 3000);
        }

        function toolbarItemClicked(args) {
            if (args.item.iconCss === 'e-icons e-refresh') {
                loadingAIAssistView.prompts = [];
                loadingAIAssistView.promptSuggestions = suggestions;
            }
        }
    </script>


    <script id="bannerContent" type="text/x-jsrender">
        <div class="banner-content">
            <div class="e-icons e-assistview-icon">
            </div><h3>AI Assistance</h3>
            <i>Explore different loading indicator types displayed while AI-generated responses are being processed.</i>
        </div>
    </script>
    <script id="dotAnimationTemplate" type="text/x-jsrender">
        <div class="assistview-dot-loading">
            <span></span>
            <span></span>
            <span></span>
        </div>
    </script>
    <script id="spinnerAnimationTemplate" type="text/x-jsrender">
        <div class="assistview-spinner-loading">
            <div class="spinner"></div>
        </div>
    </script>
    <script id="textAnimationTemplate" type="text/x-jsrender">
        <div class="assistview-status-loading">
            <span class="status-1">🧠 Understanding request...</span>
            <span class="status-2">✍️ Drafting response...</span>
            <span class="status-3">🚀 Almost ready...</span>
        </div>
    </script>
    <script id="textIndicatorAnimationTemplate" type="text/x-jsrender">
        <div class="assistview-text-indicator">
            <span>Generating</span>
            <div class="assistview-dots">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>
    </script>
}

@section Meta{
    <meta name="description" content="This example demonstrates the Loading Indicator in ASP.NET MVC AIAssistView control. Explore here for more details." />
}
@section ActionDescription{
    <div id="action-description">
        <p>This sample demonstrates the loading indicator styles that can be displayed while the AI AssistView is generating a response.</p>
    </div>
}
@section Description{
    <div id="description">
        <p>In this example, a custom loading indicator is rendered while the AI response is being generated. The selected loading type is shown from the property pane before the actual response is rendered and disappears automatically once the response is added.</p>
        <ul>
            <li><strong>Dot type:</strong> Three continuously blinking dots with a smooth scale and opacity animation. </li>
            <li><strong>Spinner type:</strong> A single circular spinner rotating continuously at 0.8s per rotation. </li>
            <li><strong>Text type:</strong> Status messages that cycle through three stages: "🧠 Understanding request..." → "✍️ Drafting response..." → "🚀 Almost ready...". Each message appears sequentially with a smooth transition.</li>
            <li><strong>Text with indicator type:</strong> "Generating" text with a subtle flashing opacity effect, accompanied by three animated dots that wave up and down with staggered delays. </li>
        </ul>
        <p>Switch the <strong>Loading Type</strong> dropdown in the property pane to preview each animation. The new indicator is applied immediately on the next prompt request without a page refresh. All animations display throughout the entire response generation period (3 seconds).</p>
    </div>
}
@section Title{
    <title>ASP.NET MVC AIAssistView Loading Indicator Example - Syncfusion Demos </title>
}
@section Header{
    <h1 class='sb-sample-text'>Example of Loading Indicator in ASP.NET MVC AIAssistView Control</h1>
}
