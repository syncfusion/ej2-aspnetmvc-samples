@using Syncfusion.EJ2
@using Syncfusion.EJ2.Grids

@{ ViewBag.StatusData = new List<object>
{
    new { status = "Active" },
    new { status = "Low Stock" },
    new { status = "Pending Restock" },
    new { status = "Out of Stock" },
    new { status = "Discontinued" }
};
var statusDropDown = new Syncfusion.EJ2.DropDowns.DropDownList()
{
    DataSource = ViewBag.StatusData,
    Query = "new ej.data.Query()",
    AllowFiltering = true,
    Fields = new Syncfusion.EJ2.DropDowns.DropDownListFieldSettings() { Value = "status", Text = "status" }
};
}

@*custom code start*@

@{
    ViewData["Title"] = "CellEdit";
}

@*custom code end*@

@section ControlsSection{
    <div class="control-section">
        <div class="content-wrapper">
            @(Html.EJS().TreeGrid("TreeGrid")
                .DataSource((IEnumerable<object>)ViewData["datasource"])
                .IdMapping("productId")
                .ParentIdMapping("parentId")
                .TreeColumnIndex(1)
                .AllowPaging(true)
                .Height(500)
                .EditSettings(edit =>
                {
                    edit.AllowAdding(true);
                    edit.AllowEditing(true);
                    edit.AllowDeleting(true);
                    edit.Mode(Syncfusion.EJ2.TreeGrid.EditMode.Cell);
                })
                .DataBound("onDataBound")
                .Toolbar(new List<string>() { "Add", "Delete", "Update", "Cancel" })
                .Columns(col =>
                {
                    col.Field("productId").HeaderText("Product ID").IsPrimaryKey(true).ValidationRules(new { required = true, number = true }).EditType("numericedit").TextAlign(TextAlign.Right).Width(110).Add();
                    col.Field("productName").HeaderText("Product Name").ValidationRules(new { required = true }).EditType("stringedit").Width(180).Add();
                    col.Field("supplier").HeaderText("Supplier").Width(170).Add();
                    col.Field("stockQty").HeaderText("Stock Qty").ValidationRules(new { required = true, number = true }).EditType("numericedit").TextAlign(TextAlign.Right).Width(100).Add();
                    col.Field("unitPrice").HeaderText("Unit Price (₹)").TextAlign(TextAlign.Right).Width(120).Format("C2").ValidationRules(new { required = true }).EditType("numericedit").Add();
                    col.Field("status").HeaderText("Status").Width(130).Template("#statusTemplate").EditType("dropdownedit").ValidationRules(new { required = true }).Edit(new { @params = statusDropDown }).Add();
                })
                .Render())
        </div>
    </div>

    <script type="text/x-template" id="statusTemplate">
        ${if(status === 'Active')}
            <span class="status-badge status-active">${status}</span>
        ${else if(status === 'Low Stock')}
            <span class="status-badge status-low-stock">${status}</span>
        ${else if(status === 'Pending Restock')}
            <span class="status-badge status-pending">${status}</span>
        ${else if(status === 'Out of Stock')}
            <span class="status-badge status-out-stock">${status}</span>
        ${else}
            <span class="status-badge status-discontinued">${status}</span>
        ${/if}
    </script>

    <script>
        // When the TreeGrid undergoes a component refresh (e.g. a global culture/currency
        // change), its internal grid is destroyed and re-created, but the column model keeps
        // edit cell objects bound to the destroyed grid whose dataSource is null. This makes
        // dropdownedit columns show "No records found". Re-bind the stale edit cells to the
        // current grid, preserving their configured params.
        function onDataBound() {
            var treegrid = document.getElementById("TreeGrid").ej2_instances[0];
            var grid = treegrid.grid;
            var rebind = function (cols) {
                (cols || []).forEach(function (col) {
                    if (col.edit && col.edit.parent !== grid) {
                        col.edit.parent = grid;
                        if (col.edit.obj) { col.edit.obj = null; }
                    }
                    if (col.columns) { rebind(col.columns); }
                });
            };
            rebind(grid.columnModel);
            rebind(grid.columns);
        }
    </script>

    <style>
        .status-badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 12px;
            font-weight: 600;
            text-align: center;
        }

        .status-active {
            color: #166534;
            background-color: #dcfce7;
        }

        .status-low-stock {
            color: #92400e;
            background-color: #fef3c7;
        }

        .status-pending {
            color: #1d4ed8;
            background-color: #dbeafe;
        }

        .status-out-stock {
            color: #991b1b;
            background-color: #fee2e2;
        }

        .status-discontinued {
            color: #374151;
            background-color: #e5e7eb;
        }
    </style>
}

@*custom code start*@

@section Meta{
    <meta name="description" content="This example demonstrates cell editing in the ASP.NET MVC Tree Grid control. Explore here for more details." />
}

@section ActionDescription{
    <div id="action-description">
        <p>
            This sample demonstrates cell editing in the TreeGrid, allowing users to quickly update individual field values directly within the data view.
        </p>
    </div>
}

@section Description{
    <div id="description">
        <p>
            Cell editing enables users to modify one cell at a time without opening a separate edit form. This mode is enabled by setting
            <code>editSettings.mode</code> as <code>Cell</code>. A cell becomes editable on
            double-clicking it, and changes are saved when the user presses the <strong>Enter</strong> key or shifts focus to another cell.
        </p>
        <p>
            This mode provides a streamlined way to update data while working within the TreeGrid. It can be used together with features such as validation, custom editors, and formatting to deliver an efficient editing experience.
        </p>
        <p>
            More information about TreeGrid editing can be found in the
            <a target="_blank" href="https://ej2.syncfusion.com/aspnetmvc/documentation/tree-grid/editing/cell-editing">
                documentation section
            </a>.
        </p>
    </div>
}

@*custom code end*@
@section Title{
    <title>ASP.NET MVC Tree Grid Cell Editing Example - Syncfusion Demos </title>
}
@section Header{
    <h1 class='sb-sample-text'>Example of Cell Editing in ASP.NET MVC Tree Grid Control</h1>
}