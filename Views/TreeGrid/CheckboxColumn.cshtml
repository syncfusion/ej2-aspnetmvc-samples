@using Syncfusion.EJ2
@using Syncfusion.EJ2.Grids
@using Syncfusion.EJ2.TreeGrid
@using Syncfusion.EJ2.DropDowns
@using EJ2MVCSampleBrowser.Models
@{
    ViewData["Title"] = "CheckboxColumn";
    var hierarchyModes = new[] {
        new { text = "Self", value = "Self" },
        new { text = "Hierarchy", value = "Hierarchy" },
        new { text = "Filtered Hierarchy", value = "FilteredHierarchy" }
    };
}

@section ControlsSection{
    <div class="control-section">
        <div class="content-wrapper">
            <div class="checkboxprop">
                <div class="checkboxmode">
                    <span>Hierarchy Checkbox Mode</span>
                    <div class="checkboxmode">
                        @Html.EJS().DropDownList("hierarchyModes").DataSource(hierarchyModes).Fields(new DropDownListFieldSettings() { Text = "text", Value = "value" }).Value("Self").Width("180px").Change("onHierarchyModeChange").Render()
                    </div>
                </div>
            </div>
            @Html.EJS().TreeGrid("TreeGrid").DataSource((IEnumerable<object>)ViewData["datasource"]).HierarchyCheckboxMode(HierarchyCheckboxMode.Self).ChildMapping("SubTasks").TreeColumnIndex(1).Toolbar(new List<string>() {"Delete", "Search" }).AllowFiltering(true).Height(380).QueryCellInfo("queryCellInfo").Columns(col =>
           {
               col.Field("TaskID").Visible(false).IsPrimaryKey(true).Add();
               col.Field("TaskName").HeaderText("Task Name").Width(270).ShowCheckbox(true).Add();
               col.Field("Assignee").HeaderText("Employee").Width(180).TextAlign(TextAlign.Center).Add();
               col.Field("Designation").HeaderText("Designation").Width(220).Add();
               col.Field("Priority").HeaderText("Priority").Width(140).TextAlign(TextAlign.Left).Add();
               col.Field("Status").HeaderText("Status").Width(120).TextAlign(TextAlign.Center).Add();
               col.Field("Progress").HeaderText("Progress").Width(120).Format("P").TextAlign(TextAlign.Right).Add();

           }).EditSettings(edit =>
            {
                edit.AllowDeleting(true);
            }).Render()
        </div>
    </div>

    <script>
        function queryCellInfo(args) {
            if (args.column.field === "Status") {
                var statusClass = args.data.Status.toLowerCase().replace(/\s+/g, "-");
                args.cell.innerHTML = '<span class="status-badge ' + statusClass + '">' + args.data.Status + '</span>';
            }
        }

        function onHierarchyModeChange(e) {
            var treegrid = document.getElementById("TreeGrid").ej2_instances[0];
            if (e.value === "Hierarchy") {
                treegrid.hierarchyCheckboxMode = "hierarchy";
            } else if (e.value === "FilteredHierarchy") {
                treegrid.hierarchyCheckboxMode = "filteredHierarchy";
            } else if (e.value === "Self") {
                treegrid.hierarchyCheckboxMode = "self";
            }
        }
    </script>
}

@section Meta{
    <meta name="description" content="This example demonstrates the Checkbox Column in ASP.NET MVC Tree Grid control. Explore here for more details." />
}

@section ActionDescription{
    <!-- custom code start -->
    <div id="action-description">
        <p>
            This sample demonstrates hierarchical checkbox selection in the TreeGrid
            using the <code>hierarchyCheckboxMode</code> property.
        </p>
    </div>
    <!-- custom code end -->
}

@section Description{
    <!-- custom code start -->
    <div id="description">
        <p>
            Checkboxes are displayed in the Tree Grid tree column by enabling the
            <code><a target="_blank" class="code"
                href="https://ej2.syncfusion.com/documentation/api/treegrid/#showcheckbox">showCheckbox</a></code>
            property. The checkbox selection behavior across hierarchical records is controlled through the
            <code><a target="_blank" class="code"
                href="https://ej2.syncfusion.com/documentation/api/treegrid/#hierarchycheckboxmode">hierarchyCheckboxMode</a></code>
            property.
        </p>

        <p>
            In <strong>self</strong> mode, selecting a checkbox affects only the clicked row.
            In <strong>hierarchy</strong> mode, selecting a parent row automatically selects all its child rows, and changes made to child rows are reflected in their parent rows.
            The <strong>filteredHierarchy</strong> mode behaves similarly to hierarchy mode but applies selection only to the rows currently visible after filtering or searching.
        </p>

        <p>
            On touch-enabled devices, checkboxes can be selected or cleared by tapping them directly.
        </p>

        <p>
            More information on checkbox column can be found in this
            <a target="_blank"
                href="https://ej2.syncfusion.com/aspnetmvc/documentation/tree-grid/columns/columns-mvc#checkbox-column">
                documentation section</a>.
        </p>

        <p>
            Looking for the full ASP.NET MVC Tree Grid component overview, features, pricing, and documentation?
            Visit our
            <a target="_blank"
                href="https://www.syncfusion.com/aspnet-mvc-ui-controls/tree-grid">
                ASP.NET MVC Tree Grid component</a>
            page.
        </p>
    </div>
    <!-- custom code end -->
}

@section Title{
                    <title>ASP.NET MVC Tree Grid Checkbox Column Example - Syncfusion Demos </title> 
                }
@section Header{
                    <h1 class='sb-sample-text'>Example of Checkbox Column in ASP.NET MVC Tree Grid Control</h1>
                }

<style>
    .e-bigger.bootstrap5 .e-treegrid .e-hierarchycheckbox .e-frame,
    .e-bigger.bootstrap5-dark .e-treegrid .e-hierarchycheckbox .e-frame,
    .e-bigger.bootstrap4 .e-treegrid .e-hierarchycheckbox .e-frame {
        height: 17px;
        width: 17px;
    }

    .checkboxprop {
        padding-bottom: 5px;
    }

    .checkboxmode {
        display: inline-block;
    }

    .checkboxprop > .checkboxmode {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .checkboxprop > .checkboxmode > span {
        white-space: nowrap;
    }

    .checkboxprop > .checkboxmode > .checkboxmode {
        flex: 0 0 180px;
        width: 180px;
    }

    .status-badge {
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 600;
        display: inline-block;
    }

    .completed {
        background: #dcfce7;
        color: #15803d;
    }

    .in-progress {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .not-started {
        background: #f3f4f6;
        color: #4b5563;
    }

    .under-review {
        background: #fef3c7;
        color: #b45309;
    }

    .blocked {
        background: #fee2e2;
        color: #dc2626;
    }
</style>