@using Syncfusion.EJ2;
@section ControlsSection{
    <div class="control-section" align="center">
        @Html.EJS().Chart("container-vertical").Series(series =>
        {
            series.Type(Syncfusion.EJ2.Charts.ChartSeriesType.StackingColumn).XName("X").YName("Samsung").DataSource(ViewData["ChartPoints"]).Border(br => br.Width(1).Color("#ffffff")).Name("Samsung").LegendShape(Syncfusion.EJ2.Charts.LegendShape.Rectangle).ColumnWidth(0.5).Marker(marker => marker.Visible(false).DataLabel(dl => dl.Visible(true).Position(Syncfusion.EJ2.Charts.LabelPosition.Top).Format("{value}M").Font(ft => ft.Color("#FFFFFF").FontWeight("700").Size("12px")))).Add();
            series.Type(Syncfusion.EJ2.Charts.ChartSeriesType.StackingColumn).XName("X").YName("Apple").DataSource(ViewData["ChartPoints"]).Border(br => br.Width(1).Color("#ffffff")).Name("Apple").LegendShape(Syncfusion.EJ2.Charts.LegendShape.Rectangle).ColumnWidth(0.5).Marker(marker => marker.Visible(false).DataLabel(dl => dl.Visible(true).Position(Syncfusion.EJ2.Charts.LabelPosition.Top).Format("{value}M").Font(ft => ft.Color("#FFFFFF").FontWeight("700").Size("12px")))).Add();
            series.Type(Syncfusion.EJ2.Charts.ChartSeriesType.StackingColumn).XName("X").YName("Xiaomi").DataSource(ViewData["ChartPoints"]).Border(br => br.Width(1).Color("#ffffff")).Name("Xiaomi").LegendShape(Syncfusion.EJ2.Charts.LegendShape.Rectangle).ColumnWidth(0.5).Marker(marker => marker.Visible(false).DataLabel(dl => dl.Visible(true).Position(Syncfusion.EJ2.Charts.LabelPosition.Top).Format("{value}M").Font(ft => ft.Color("#FFFFFF").FontWeight("700").Size("12px")))).Add();
            series.Type(Syncfusion.EJ2.Charts.ChartSeriesType.StackingColumn).XName("X").YName("Oppo").DataSource(ViewData["ChartPoints"]).Border(br => br.Width(1).Color("#ffffff")).Name("OPPO").LegendShape(Syncfusion.EJ2.Charts.LegendShape.Rectangle).ColumnWidth(0.5).Marker(marker => marker.Visible(false).DataLabel(dl => dl.Visible(true).Position(Syncfusion.EJ2.Charts.LabelPosition.Top).Format("{value}M").Font(ft => ft.Color("#FFFFFF").FontWeight("700").Size("12px")))).Add();
            series.Type(Syncfusion.EJ2.Charts.ChartSeriesType.StackingColumn).XName("X").YName("Vivo").DataSource(ViewData["ChartPoints"]).Border(br => br.Width(1).Color("#ffffff")).Name("vivo").LegendShape(Syncfusion.EJ2.Charts.LegendShape.Rectangle).ColumnWidth(0.5).Marker(marker => marker.Visible(false).DataLabel(dl => dl.Visible(true).Position(Syncfusion.EJ2.Charts.LabelPosition.Top).Format("{value}M").Font(ft => ft.Color("#FFFFFF").FontWeight("700").Size("12px")))).Add();
            series.Type(Syncfusion.EJ2.Charts.ChartSeriesType.StackingColumn).XName("X").YName("Others").DataSource(ViewData["ChartPoints"]).Border(br => br.Width(1).Color("#ffffff")).Name("Others").LegendShape(Syncfusion.EJ2.Charts.LegendShape.Rectangle).ColumnWidth(0.5).Marker(marker => marker.Visible(false).DataLabel(dl => dl.Visible(true).Position(Syncfusion.EJ2.Charts.LabelPosition.Top).Format("{value}M").Font(ft => ft.Color("#FFFFFF").FontWeight("700").Size("12px")))).Add();
        }).PrimaryXAxis(px => px.ValueType(Syncfusion.EJ2.Charts.ValueType.Category).MajorGridLines(mg => mg.Width(0)).MinorGridLines(mg => mg.Width(0)).MajorTickLines(mt => mt.Width(0)).MinorTickLines(mt => mt.Width(0)).LineStyle(ls => ls.Width(0)).Interval(1).LabelIntersectAction(Syncfusion.EJ2.Charts.LabelIntersectAction.Rotate45)).PrimaryYAxis(py => py.Title("Shipments (Millions of Units)").LabelFormat("{value}M").Minimum(0).Maximum(400).Interval(50).MajorGridLines(mg => mg.Color("#E2E8F0").Width(1)).MajorTickLines(mt => mt.Width(0)).MinorGridLines(mg => mg.Width(0)).MinorTickLines(mt => mt.Width(0)).LineStyle(ls => ls.Width(0))).Title("Global Smartphone Shipments by Vendor (2025)").SubTitle("Smart labels automatically reposition small stacked-segment labels to avoid overlap.").ChartArea(area => area.Border(br => br.Width(0))).Tooltip(tt => tt.Enable(true).EnableHighlight(true).Shared(true).Header("${point.x}").Format("${series.name}: <b>${point.y}</b>")).LegendSettings(leg => leg.Visible(true).EnableHighlight(true).Position(Syncfusion.EJ2.Charts.LegendPosition.Bottom).ShapeHeight(9).ShapeWidth(9)).TextRender("textRender").Load("load").Render()
    </div>

    @*custom code start*@
    <style>
        #control-container {
            padding: 0px !important;
        }
    </style>
    @*custom code end*@
    <script src="~/Scripts/chart/theme-color.js"></script>
    <script>
        var seriesColors = ['#6355C7', '#00AEE0', '#FFB400', '#4CAF50', '#E56590', '#9B59B6'];

        var load = function (args) {
            loadChartTheme(args);
            args.chart.width = ej.base.Browser.isDevice ? "100%" : "75%";

            for (var i = 0; i < args.chart.series.length; i++) {
                var dataLabel = args.chart.series[i].marker.dataLabel;
                dataLabel.position = 'Top';
                dataLabel.format = '{value}M';
                dataLabel.labelIntersectAction = 'RelocateHorizontally';
                dataLabel.font = { color: '#FFFFFF', fontWeight: '700', size: '12px', fontFamily: 'Segoe UI' };
                dataLabel.margin = { left: 24, right: 24, top: 12, bottom: 12 };
                dataLabel.smartLabelSettings = {
                    background: seriesColors[i],
                    border: { color: seriesColors[i], width: 1.5 },
                    connectorLineStyle: { color: seriesColors[i], width: 2 },
                    pointerShape: 'Arrow'
                };
                dataLabel.rx = 7;
                dataLabel.ry = 7;
            }
        }

        var textRender = function (args) {
            if (!args.point || typeof args.point.y !== 'number') {
                return;
            }

            if (args.point.y < 3) {
                args.cancel = true;
            }
        }
    </script>
}
@section Meta{
    <meta name="description" content="This example demonstrates Stacked Smart Labels in ASP.NET MVC Chart control. Explore here for more details."/>
}
@section ActionDescription{
    <p>
        This sample shows the global smartphone shipment trends by vendor using smart labels in a stacked column chart.
    </p>
}
@section Description{
    <p>
        In this example, you can see how the labels can be arranged smartly without overlapping. When a stacked segment does not have enough space to display a data label, the label is automatically moved outside the segment and connected using a callout line.
    </p>
    <p>
        <code>Tooltip</code> is enabled in this example. To see the tooltip in action, hover over a point or tap on a point in touch-enabled devices.
    </p>
    <p>
        More information on the smart labels can be found in this
        <a target="_blank" href="https://ej2.syncfusion.com/documentation/chart/data-labels/" aria-label="documentation section">documentation section<span class="sr-only">opens in a new tab</span></a>.
    </p>
}
@section Title{
    <title>ASP.NET MVC Chart Stacked Smart Labels Example - Syncfusion Demos </title>
}
@section Header{
    <h1 class='sb-sample-text'>Charts</h1>
}
